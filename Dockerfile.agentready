# Extend only the native source image built from the same commit in agentsee-release.yml.
ARG HERMES_SOURCE_IMAGE
FROM registry.k8s.io/kubectl:v1.35.8@sha256:1ec2791a3ddd245559e18a887f2dcd25cdfee7a649c5b73ca2715e3d7f6bf6f8 AS kubectl
FROM docker:28.5.1-dind@sha256:ea9d20492ca1caaaba78e68453433895d256173c79281756e88b745647fcbcfd AS init
FROM ${HERMES_SOURCE_IMAGE}
ARG HERMES_GIT_SHA
ARG AGENTSEE_RELEASE_VERSION
USER root
WORKDIR /opt/hermes
RUN /opt/hermes/.venv/bin/python deploy/kubernetes/release_source.py verify /opt/hermes
COPY --from=kubectl /bin/kubectl /usr/local/bin/kubectl
COPY --from=init /usr/local/bin/docker-init /usr/local/bin/agentsee-init
ADD --checksum=sha256:79b8aa8594ca03b44569646cca6a7bd36b22616224d8ad7e6f28d75ad43e3659 https://codeload.github.com/NousResearch/hermes-official-plugins/tar.gz/2da429264671788748f69bca7d5a2216c1885b92 /opt/claude-provider.tar.gz
RUN mkdir -p plugins/model-providers/claude-subscription-directsdk-experimental \
    && tar -xzf /opt/claude-provider.tar.gz --strip-components=2 \
       -C plugins/model-providers/claude-subscription-directsdk-experimental \
       hermes-official-plugins-2da429264671788748f69bca7d5a2216c1885b92/claude-subscription-directsdk \
    && rm /opt/claude-provider.tar.gz \
    && npm install --global --prefix /usr/local --include=optional --ignore-scripts --no-audit --no-fund @anthropic-ai/claude-code@2.1.293 \
    && node /usr/local/lib/node_modules/@anthropic-ai/claude-code/install.cjs \
    && claude --version \
    && /opt/hermes/.venv/bin/python deploy/kubernetes/release_source.py record-plugin /opt/hermes \
    && /opt/hermes/.venv/bin/python deploy/kubernetes/release_source.py verify /opt/hermes
RUN /opt/hermes/.venv/bin/python -c 'import json,os; from pathlib import Path; p=Path("/etc/hermes/image-provenance.json"); v=json.loads(p.read_text()); v.update(image="agentready-tech/hermes-agent", revision=os.environ["HERMES_GIT_SHA"], version=os.environ["AGENTSEE_RELEASE_VERSION"]); p.write_text(json.dumps(v)+"\n"); p.chmod(0o444)'
LABEL org.opencontainers.image.source="https://github.com/agentready-tech/hermes-agent" \
      org.opencontainers.image.revision="${HERMES_GIT_SHA}" \
      org.opencontainers.image.version="${AGENTSEE_RELEASE_VERSION}" \
      io.agentsee.runtime.policy="common" \
      io.agentsee.runtime.source="clean-git-archive" \
      io.agentsee.runtime.capabilities="auxiliary-gateway-v1,workspace-inbox-v1,subscriptions-v1,agent-sandbox-v1"
CMD ["hermes-autonomous", "run", "--host", "0.0.0.0"]
